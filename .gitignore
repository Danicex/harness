# ==========================================
# 1. Environment & Sensitive Configs (DO NOT SHIP)
# ==========================================
# Server-specific paths
server/.env
server/myenv/
server/uploads/

# Root or general environment variables
.env
*.env
*.local
*env
env

# ==========================================
# 2. Dependency & Build Folders (Across all folders)
# ==========================================
# Excludes node_modules from both frontend and backend
**/node_modules/
node_modules/

# Build and distribution output directories
**/dist/
**/dist-ssr/

# Python virtual environment (if server/myenv is Python-based)
**/venv/
**/.venv/

# ==========================================
# 3. Logs & Debug Files
# ==========================================
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ==========================================
# 4. Editor Directories & System Artifacts
# ==========================================
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
